+/** Merge optional replies for one session/sequence without replacing OEM permissions. */
+internal fun mergeCameraReply(previous: NavAssistV3UdpAck?, incoming: NavAssistV3UdpAck): NavAssistV3UdpAck {
+    if (previous == null) return incoming
+    val old = previous.vehicleLane
+    val next = incoming.vehicleLane
+    val camera = next?.cameraLanePosition ?: old?.cameraLanePosition
+    val base = if (next?.cameraLanePosition != null && old != null) old else next ?: old
+    return incoming.copy(vehicleLane = base?.copy(cameraLanePosition = camera),
+        announcement = incoming.announcement ?: previous.announcement)
+}
