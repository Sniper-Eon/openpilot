+package com.garan.tesnav.model
+
+/** Absolute road index, 1-based from the left. Never an OEM control permission. */
+data class CameraLanePosition(
+    val valid: Boolean,
+    val laneIndex: Int?,
+    val laneCount: Int?,
+    val ageAtReceiptMs: Long,
+    val validForMs: Long,
+    val receivedAtElapsedMs: Long,
+    val routeRevision: Long,
+) {
+    fun remainingMs(nowElapsedMs: Long): Long {
+        if (!valid || nowElapsedMs < receivedAtElapsedMs) return 0L
+        return (validForMs - ageAtReceiptMs - (nowElapsedMs - receivedAtElapsedMs)).coerceAtLeast(0L)
+    }
+
+    fun forDisplay(nowElapsedMs: Long): CameraLanePosition =
+        if (remainingMs(nowElapsedMs) > 0L) this else copy(valid = false, laneIndex = null)
+
+    fun label(): String = if (valid && laneIndex != null) {
+        if (laneCount != null) "第 $laneIndex／$laneCount 车道" else "第 $laneIndex 车道"
+    } else "未知"
+}
