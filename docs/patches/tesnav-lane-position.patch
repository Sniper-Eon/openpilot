@@ -0,0 +1,43 @@
+package com.garan.tesnav.export
+
+import org.junit.Assert.*
+import org.junit.Test
+
+class CameraLanePositionParserTest {
+    private fun parse(position: String, age: Long = 0L) = NavAssistV3AckParser.parse(
+        """{"messageType":"navassist_udp_ack","schemaVersion":3,"sessionId":"s","sequence":1,"lanePosition":$position}""".encodeToByteArray(),
+        "10.0.0.2", "s", 1, 10_000, 1_000, age,
+    )
+    private val good = """{"version":1,"valid":true,"laneIndex":2,"laneCount":4,"numbering":"leftToRight","source":"commaCamera","ageMs":300,"validForMs":2000,"routeRevision":2}"""
+
+    @Test fun `explicit road number is independent from OEM permissions`() {
+        val state = parse(good)!!.vehicleLane!!
+        assertEquals(2, state.cameraLanePosition!!.laneIndex)
+        assertEquals(4, state.cameraLanePosition!!.laneCount)
+        assertFalse(state.positionValid)
+        assertFalse(state.permissionValid)
+    }
+    @Test fun `expired and malformed position never becomes a lane number`() {
+        assertFalse(parse(good, 1_800)!!.vehicleLane!!.cameraLanePosition!!.valid)
+        assertFalse(parse(good)!!.vehicleLane!!.forDisplay(2_700, 3_000).cameraLanePosition!!.valid)
+        for (bad in listOf(good.replace("\"laneIndex\":2", "\"laneIndex\":5"),
+            good.replace("\"laneIndex\":2", "\"laneIndex\":true"),
+            good.replace("leftToRight", "rightToLeft"), good.replace("commaCamera", "visibleCorridor"))) {
+            assertNull(parse(bad)!!.vehicleLane?.cameraLanePosition)
+        }
+        val unknown = good.replace("\"valid\":true", "\"valid\":false").replace("\"laneIndex\":2", "\"laneIndex\":null")
+        assertFalse(parse(unknown)!!.vehicleLane!!.cameraLanePosition!!.valid)
+        assertEquals("未知", parse(unknown)!!.vehicleLane!!.cameraLanePosition!!.label())
+    }
+    @Test fun `reordered optional replies preserve independent OEM permissions`() {
+        val numbered = parse(good)!!
+        val oem = NavAssistV3UdpAck("10.0.0.2", com.garan.tesnav.model.OemVehicleLaneState(
+            positionValid = true, permissionValid = true, leftAllowed = true))
+        for (merged in listOf(mergeCameraReply(oem, numbered), mergeCameraReply(numbered, oem))) {
+            assertEquals(2, merged.vehicleLane!!.cameraLanePosition!!.laneIndex)
+            assertTrue(merged.vehicleLane!!.permissionValid)
+            assertTrue(merged.vehicleLane!!.leftAllowed)
+        }
+    }
+
+}
