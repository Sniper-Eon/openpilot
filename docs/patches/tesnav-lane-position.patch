+    @Test fun `camera expires independently while OEM permission stays fresh`() = runBlocking {
+        val now = AtomicLong(1_000L)
+        val original = feedback().copy(cameraLanePosition = CameraLanePosition(
+            true, 2, 4, 0, 20, 1_000, 2))
+        val source = MutableStateFlow(original)
+        val events = Channel<OemVehicleLaneState>(Channel.UNLIMITED)
+        val job = launch { source.withDisplayExpiry(80L, now::get).collect { events.send(it) } }
+        try {
+            assertTrue(withTimeout(2_000L) { events.receive() }.cameraLanePosition!!.valid)
+            now.set(1_020L)
+            val expired = withTimeout(2_000L) { events.receive() }
+            assertFalse(expired.cameraLanePosition!!.valid)
+            assertTrue(expired.permissionValid)
+            assertTrue(source.value.cameraLanePosition!!.valid)
+            now.set(1_080L)
+            assertFalse(withTimeout(2_000L) { events.receive() }.permissionValid)
+        } finally {
+            job.cancelAndJoin()
+            events.close()
+        }
+    }
