+++ b/app/src/main/kotlin/com/garan/tesnav/service/KeylessAutoService.kt
@@ -0,0 +1,450 @@
+package com.garan.tesnav.service
+
+import android.app.Notification
+import android.app.NotificationChannel
+import android.app.NotificationManager
+import android.app.PendingIntent
+import android.app.Service
+import android.content.BroadcastReceiver
+import android.content.Context
+import android.content.Intent
+import android.content.IntentFilter
+import android.content.pm.ServiceInfo
+import android.location.Location
+import android.location.LocationListener
+import android.location.LocationManager
+import android.os.Binder
+import android.os.Build
+import android.os.Bundle
+import android.os.IBinder
+import android.os.Looper
+import android.os.PowerManager
+import android.os.SystemClock
+import androidx.core.app.NotificationCompat
+import androidx.core.content.ContextCompat
+import com.garan.tesnav.BuildConfig
+import com.garan.tesnav.KeylessAutoActivity
+import com.garan.tesnav.export.AndroidKeystoreNavAssistIdentity
+import com.garan.tesnav.export.HttpNavAssistV2Exporter
+import com.garan.tesnav.export.JvmUdpNavAssistV3Client
+import com.garan.tesnav.export.NavAssistPairingStore
+import com.garan.tesnav.export.NavAssistV2ExportConfig
+import com.garan.tesnav.export.NavAssistV2Protocol
+import com.garan.tesnav.export.NavAssistV2Session
+import com.garan.tesnav.export.UdpNavAssistV2EndpointDiscovery
+import com.garan.tesnav.model.NavigationState
+import com.garan.tesnav.util.NavigationTrace
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.Job
+import kotlinx.coroutines.SupervisorJob
+import kotlinx.coroutines.cancel
+import kotlinx.coroutines.delay
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+import kotlinx.coroutines.isActive
+import kotlinx.coroutines.launch
+
+/**
+ * Foreground forwarding entry that needs no AMap Key.
+ *
+ * It uses only the Amap Auto broadcast parser, Android [LocationManager] and the
+ * existing NavAssist v3 UDP exporter. No map, navigation or SDK coordinate
+ * conversion is initialized here, so a missing AMap Key cannot affect it.
+ *
+ * The exported session declares wgs84 because its only position source is
+ * Android GPS. Broadcast GCJ02 positions are dropped by [KeylessAutoState] and
+ * are never mixed with the phone fix.
+ */
+class KeylessAutoService : Service() {
+    private val scope = CoroutineScope(SupervisorJob() + Dispatchers.Main.immediate)
+    private val binder = LocalBinder()
+
+    private lateinit var keylessState: KeylessAutoState
+    private lateinit var session: NavAssistV2Session
+    private lateinit var exporter: HttpNavAssistV2Exporter
+
+    private var locationManager: LocationManager? = null
+    private var locationListener: LocationListener? = null
+    private var receiver: BroadcastReceiver? = null
+    private var wakeLock: PowerManager.WakeLock? = null
+    private var evaluationJob: Job? = null
+    private var observationJob: Job? = null
+
+    @Volatile private var latestState = NavigationState()
+    @Volatile private var phoneFix: NavigationState? = null
+    private var lastLocationRejection = KeylessLocationRejection.PROVIDER_DISABLED
+    private var mockRejectedCount = 0L
+    private var validForMs = 0L
+
+    private var c3Status = com.garan.tesnav.export.NavAssistV2ConnectionStatus.UNCONFIGURED
+    private var c3Endpoint: String? = null
+    private var c3Error: String? = null
+    private var c3Sequence: Long? = null
+    private var c3Acknowledged = false
+    private var cameraLane: com.garan.tesnav.model.CameraLanePosition? = null
+
+    private val mutableDisplay = MutableStateFlow(initialDisplay())
+    internal val display: StateFlow<KeylessAutoDisplay> = mutableDisplay.asStateFlow()
+
+    private var lastNotificationLine: String? = null
+
+    inner class LocalBinder : Binder() {
+        fun getService(): KeylessAutoService = this@KeylessAutoService
+    }
+
+    override fun onBind(intent: Intent?): IBinder = binder
+
+    override fun onCreate() {
+        super.onCreate()
+        instanceAlive = true
+        createNotificationChannel()
+        promoteToForeground()
+        acquireWakeLock()
+
+        val budgetMs = BuildConfig.NAV_ASSIST_SOURCE_BUDGET_MS
+        keylessState = KeylessAutoState(budgetMs, BuildConfig.NAV_ASSIST_PROGRESS_BUDGET_MS)
+        keylessState.start(SystemClock.elapsedRealtime())
+
+        // A stopped exporter is terminal and a restart must not inherit a
+        // sequence or a session, so every service instance builds both anew.
+        val config = NavAssistV2ExportConfig(
+            baseUrl = BuildConfig.NAV_ASSIST_V2_URL,
+            intervalMs = BuildConfig.NAV_ASSIST_V2_INTERVAL_MS,
+        )
+        session = NavAssistV2Session(
+            validForMs = config.validForMs,
+            coordinateSystem = NavAssistV2Protocol.COORDINATE_SYSTEM_WGS84,
+        )
+        val identity = AndroidKeystoreNavAssistIdentity.loadOrCreate(applicationContext)
+        val pairingStore = NavAssistPairingStore(applicationContext)
+        exporter = HttpNavAssistV2Exporter(
+            config = config,
+            stateProvider = { if (keylessState.hasObservations) latestState else null },
+            identity = identity,
+            endpointDiscovery = UdpNavAssistV2EndpointDiscovery(identity, pairingStore),
+            pinnedDeviceProvider = pairingStore::pinnedDevice,
+            useUnauthenticatedUdp = true,
+            requireOwnerHandshake = true,
+            monotonicMs = { SystemClock.elapsedRealtime() },
+            udpClient = JvmUdpNavAssistV3Client(
+                if (BuildConfig.DEBUG) { line -> NavigationTrace.append(filesDir, line, "KeylessAuto-UDP") } else null,
+            ),
+        )
+
+        validForMs = config.validForMs
+        registerBroadcasts()
+        startLocationUpdates()
+        startObservation()
+        evaluationJob = scope.launch {
+            while (isActive) {
+                evaluate()
+                delay(EVALUATION_INTERVAL_MS)
+            }
+        }
+        exporter.start()
+    }
+
+    override fun onStartCommand(intent: Intent?, flags: Int, startId: Int): Int {
+        if (intent?.action == ACTION_STOP) {
+            stopSelf()
+            return START_NOT_STICKY
+        }
+        return START_NOT_STICKY
+    }
+
+    /** Stops forwarding and releases every resource; a restart creates a new instance. */
+    fun stopForwarding() {
+        stopSelf()
+    }
+
+    override fun onDestroy() {
+        instanceAlive = false
+        evaluationJob?.cancel()
+        observationJob?.cancel()
+        evaluationJob = null
+        observationJob = null
+        locationListener?.let { listener -> runCatching { locationManager?.removeUpdates(listener) } }
+        locationListener = null
+        locationManager = null
+        receiver?.let { runCatching { unregisterReceiver(it) } }
+        receiver = null
+        if (::exporter.isInitialized) exporter.stop()
+        phoneFix = null
+        releaseWakeLock()
+        scope.cancel()
+        stopForegroundCompat()
+        super.onDestroy()
+    }
+
+    private fun evaluate() {
+        val nowWallMs = System.currentTimeMillis()
+        val nowElapsedMs = SystemClock.elapsedRealtime()
+        latestState = keylessState.snapshot(nowWallMs, nowElapsedMs)
+        val rejection = locationRejection(nowWallMs)
+        val fix = phoneFix
+        val display = KeylessAutoPresenter.present(
+            KeylessAutoInputs(
+                running = instanceAlive,
+                broadcastKeyType = keylessState.lastBroadcastKeyType,
+                broadcastAgeMs = keylessState.broadcastAgeMs(nowWallMs),
+                broadcastFresh = keylessState.broadcastFresh(nowWallMs),
+                broadcastCount = keylessState.broadcastCount,
+                locationRejection = rejection,
+                locationAccuracyM = fix?.accuracy,
+                locationAgeMs = fix?.locationObservedAtMs?.let { nowWallMs - it },
+                mockRejectedCount = mockRejectedCount,
+                navigation = latestState,
+                c3Status = c3Status,
+                c3Endpoint = c3Endpoint,
+                c3Error = c3Error,
+                c3Sequence = c3Sequence,
+                c3Acknowledged = c3Acknowledged,
+                cameraLane = cameraLane,
+                sessionId = session.sessionId,
+                coordinateSystem = NavAssistV2Protocol.COORDINATE_SYSTEM_WGS84,
+                validForMs = validForMs,
+                nowElapsedMs = nowElapsedMs,
+            ),
+        )
+        mutableDisplay.value = display
+        updateNotification(display.headline)
+    }
+
+    private fun locationRejection(nowWallMs: Long): KeylessLocationRejection {
+        val fix = phoneFix ?: return lastLocationRejection
+        val observedAt = fix.locationObservedAtMs ?: return lastLocationRejection
+        val age = nowWallMs - observedAt
+        return when {
+            age < 0L -> KeylessLocationRejection.CLOCK_INVALID
+            age <= KEYLESS_LOCATION_MAX_AGE_MS -> KeylessLocationRejection.NONE
+            else -> KeylessLocationRejection.STALE
+        }
+    }
+
+    private fun startObservation() {
+        // Child coroutines of one job so onDestroy cancels every collector together.
+        observationJob = scope.launch {
+            launch { exporter.connectionState.collect { runCatching { evaluate() } } }
+            launch { exporter.status.collect { c3Status = it; runCatching { evaluate() } } }
+            launch { exporter.resolvedEndpoint.collect { c3Endpoint = it; runCatching { evaluate() } } }
+            launch { exporter.lastError.collect { c3Error = it; runCatching { evaluate() } } }
+            launch {
+                exporter.deliveryState.collect { delivery ->
+                    c3Sequence = delivery.sequence
+                    c3Acknowledged = delivery.acknowledged
+                    runCatching { evaluate() }
+                }
+            }
+            launch {
+                exporter.oemVehicleLaneState.collect { lane ->
+                    cameraLane = lane.cameraLanePosition
+                    runCatching { evaluate() }
+                }
+            }
+        }
+    }
+
+    private fun registerBroadcasts() {
+        if (receiver != null) return
+        val registered = object : BroadcastReceiver() {
+            @Suppress("DEPRECATION")
+            override fun onReceive(context: Context?, intent: Intent?) {
+                val extras = intent?.extras ?: return
+                val values = extras.keySet().associateWith { key -> runCatching { extras.get(key) }.getOrNull() }
+                keylessState.receive(
+                    intent.action, values, System.currentTimeMillis(), SystemClock.elapsedRealtime(),
+                )
+            }
+        }
+        val filter = IntentFilter().apply {
+            addAction(AMAP_AUTO_BROADCAST_SEND)
+            addAction(AMAP_AUTO_BROADCAST_RECV)
+        }
+        ContextCompat.registerReceiver(this, registered, filter, ContextCompat.RECEIVER_EXPORTED)
+        receiver = registered
+    }
+
+    private fun startLocationUpdates() {
+        val manager = getSystemService(Context.LOCATION_SERVICE) as? LocationManager
+        if (manager == null) {
+            lastLocationRejection = KeylessLocationRejection.PROVIDER_DISABLED
+            return
+        }
+        locationManager = manager
+        val listener = object : LocationListener {
+            override fun onLocationChanged(location: Location) = acceptLocation(location)
+
+            override fun onProviderEnabled(provider: String) {
+                if (lastLocationRejection == KeylessLocationRejection.PROVIDER_DISABLED) {
+                    lastLocationRejection = KeylessLocationRejection.STALE
+                }
+            }
+
+            override fun onProviderDisabled(provider: String) {
+                phoneFix = null
+                lastLocationRejection = KeylessLocationRejection.PROVIDER_DISABLED
+                keylessState.phoneLocation(null)
+            }
+
+            @Deprecated("Legacy callback")
+            override fun onStatusChanged(provider: String?, status: Int, extras: Bundle?) {}
+        }
+        locationListener = listener
+        val listening = runCatching {
+            manager.requestLocationUpdates(
+                LocationManager.GPS_PROVIDER, LOCATION_INTERVAL_MS, 0f, listener, Looper.getMainLooper(),
+            )
+            true
+        }.getOrDefault(false)
+        if (!listening) lastLocationRejection = KeylessLocationRejection.PROVIDER_DISABLED
+    }
+
+    @Suppress("DEPRECATION")
+    private fun acceptLocation(location: Location) {
+        val nowWallMs = System.currentTimeMillis()
+        val nowElapsedMs = SystemClock.elapsedRealtime()
+        val outcome = keylessLocationOutcome(
+            KeylessLocationSample(
+                latitude = location.latitude,
+                longitude = location.longitude,
+                accuracyM = location.accuracy,
+                hasAccuracy = location.hasAccuracy(),
+                bearingDeg = location.bearing.takeIf { location.hasBearing() },
+                speedMps = location.speed.takeIf { location.hasSpeed() },
+                measuredAtMs = location.time,
+                receivedElapsedMs = nowElapsedMs,
+                fromMockProvider = location.isFromMockProvider,
+            ),
+            nowWallMs,
+            nowElapsedMs,
+        )
+        when (outcome) {
+            is KeylessLocationOutcome.Accepted -> {
+                phoneFix = outcome.state
+                lastLocationRejection = KeylessLocationRejection.NONE
+                keylessState.phoneLocation(outcome.state)
+            }
+            is KeylessLocationOutcome.Rejected -> {
+                phoneFix = null
+                lastLocationRejection = outcome.reason
+                if (outcome.reason == KeylessLocationRejection.MOCK) mockRejectedCount += 1
+                keylessState.phoneLocation(null)
+            }
+        }
+    }
+
+    private fun createNotificationChannel() {
+        if (Build.VERSION.SDK_INT < Build.VERSION_CODES.O) return
+        val channel = NotificationChannel(
+            CHANNEL_ID,
+            "车机广播转发",
+            NotificationManager.IMPORTANCE_LOW,
+        ).apply { description = "免高德 Key 的车机导航转发与定位" }
+        (getSystemService(NotificationManager::class.java))?.createNotificationChannel(channel)
+    }
+
+    private fun promoteToForeground() {
+        val notification = buildNotification("正在启动车机广播转发")
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.Q) {
+            startForeground(NOTIFICATION_ID, notification, ServiceInfo.FOREGROUND_SERVICE_TYPE_LOCATION)
+        } else {
+            startForeground(NOTIFICATION_ID, notification)
+        }
+    }
+
+    private fun updateNotification(headline: String) {
+        if (headline == lastNotificationLine) return
+        lastNotificationLine = headline
+        (getSystemService(NotificationManager::class.java))?.notify(
+            NOTIFICATION_ID, buildNotification(headline),
+        )
+    }
+
+    private fun buildNotification(text: String): Notification {
+        val open = PendingIntent.getActivity(
+            this, 0, Intent(this, KeylessAutoActivity::class.java),
+            PendingIntent.FLAG_UPDATE_CURRENT or PendingIntent.FLAG_IMMUTABLE,
+        )
+        val stop = PendingIntent.getService(
+            this, 1, Intent(this, KeylessAutoService::class.java).setAction(ACTION_STOP),
+            PendingIntent.FLAG_UPDATE_CURRENT or PendingIntent.FLAG_IMMUTABLE,
+        )
+        return NotificationCompat.Builder(this, CHANNEL_ID)
+            .setContentTitle("特会开 · 车机广播转发")
+            .setContentText(text)
+            .setSmallIcon(android.R.drawable.ic_menu_mylocation)
+            .setOngoing(true)
+            .setOnlyAlertOnce(true)
+            .setContentIntent(open)
+            .addAction(0, "停止", stop)
+            .build()
+    }
+
+    @Suppress("DEPRECATION")
+    private fun stopForegroundCompat() {
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.N) {
+            stopForeground(STOP_FOREGROUND_REMOVE)
+        } else {
+            stopForeground(true)
+        }
+    }
+
+    private fun acquireWakeLock() {
+        if (wakeLock != null) return
+        val power = getSystemService(Context.POWER_SERVICE) as? PowerManager ?: return
+        wakeLock = runCatching {
+            power.newWakeLock(PowerManager.PARTIAL_WAKE_LOCK, "tesnav:keylessAuto").apply { acquire() }
+        }.getOrNull()
+    }
+
+    private fun releaseWakeLock() {
+        runCatching { wakeLock?.takeIf { it.isHeld }?.release() }
+        wakeLock = null
+    }
+
+    private fun initialDisplay(): KeylessAutoDisplay = KeylessAutoPresenter.present(
+        KeylessAutoInputs(
+            running = false,
+            broadcastKeyType = null,
+            broadcastAgeMs = null,
+            broadcastFresh = false,
+            broadcastCount = 0L,
+            locationRejection = KeylessLocationRejection.PROVIDER_DISABLED,
+            locationAccuracyM = null,
+            locationAgeMs = null,
+            mockRejectedCount = 0L,
+            navigation = NavigationState(),
+            c3Status = com.garan.tesnav.export.NavAssistV2ConnectionStatus.UNCONFIGURED,
+            c3Endpoint = null,
+            c3Error = null,
+            c3Sequence = null,
+            c3Acknowledged = false,
+            cameraLane = null,
+            sessionId = "--------",
+            coordinateSystem = NavAssistV2Protocol.COORDINATE_SYSTEM_WGS84,
+            validForMs = 0L,
+            nowElapsedMs = 0L,
+        ),
+    )
+
+    companion object {
+        internal const val ACTION_STOP = "com.garan.tesnav.action.STOP_KEYLESS_AUTO"
+        internal const val AMAP_AUTO_BROADCAST_SEND = "AUTONAVI_STANDARD_BROADCAST_SEND"
+        internal const val AMAP_AUTO_BROADCAST_RECV = "AUTONAVI_STANDARD_BROADCAST_RECV"
+
+        private const val CHANNEL_ID = "tesnav_keyless_auto"
+        private const val NOTIFICATION_ID = 1002
+        private const val LOCATION_INTERVAL_MS = 1_000L
+        private const val EVALUATION_INTERVAL_MS = 250L
+
+        /** Same process only; lets the Activity rebind without creating the service on its own. */
+        @Volatile internal var instanceAlive = false
+            private set
+
+        fun start(context: Context) {
+            ContextCompat.startForegroundService(context, Intent(context, KeylessAutoService::class.java))
+        }
+    }
+}
diff --git a/app/src/main/kotlin/com/garan/tesnav/service/KeylessAutoState.kt b/app/src/main/kotlin/com/garan/tesnav/service/KeylessAutoState.kt
new file mode 100644
index 0000000..291afd7
--- /dev/null
+++ b/app/src/main/kotlin/com/garan/tesnav/service/KeylessAutoState.kt
@@ -0,0 +1,107 @@
+package com.garan.tesnav.service
+
+import com.garan.tesnav.model.NavigationSourceGate
+import com.garan.tesnav.model.NavigationState
+
+/**
+ * Pure state for the keyless car-machine broadcast entry.
+ *
+ * The Amap Auto broadcast reports GCJ02 positions, while this entry's only
+ * position source is the phone's Android GPS, which is WGS84. Every broadcast
+ * coordinate field is therefore removed before parsing, so a GCJ02 fix can never
+ * be labelled as, or blended with, a WGS84 observation. The exported session
+ * declares wgs84 accordingly.
+ *
+ * Nothing here initializes an AMap SDK: it only reuses the existing broadcast
+ * parser, the shared source gate and the UDP exporter.
+ */
+internal class KeylessAutoState(private val budgetMs: Long, progressMs: Long) {
+    private val gate = NavigationSourceGate(budgetMs, progressMs)
+    private var navigation: NavigationState? = null
+    // Volatile because the exporter reads hasObservations from its own thread.
+    @Volatile private var phone: NavigationState? = null
+
+    @Volatile
+    var lastBroadcastMs: Long = 0L
+        private set
+    var lastBroadcastKeyType: Int? = null
+        private set
+    var broadcastCount: Long = 0L
+        private set
+
+    /** No exported state exists until a broadcast or a phone fix is observed. */
+    val hasObservations: Boolean get() = lastBroadcastMs > 0L || phone != null
+
+    @Synchronized
+    fun start(elapsedMs: Long) {
+        navigation = null
+        phone = null
+        lastBroadcastMs = 0L
+        lastBroadcastKeyType = null
+        broadcastCount = 0L
+        gate.arm(elapsedMs)
+    }
+
+    @Synchronized
+    fun phoneLocation(value: NavigationState?) {
+        phone = value
+    }
+
+    @Synchronized
+    fun receive(action: String?, values: Map<String, Any?>, wallMs: Long, elapsedMs: Long) {
+        val key = AmapAutoBroadcast.capture(action, values, wallMs).keyType ?: return
+        if (key !in SUPPORTED_KEYS) return
+        lastBroadcastMs = wallMs
+        lastBroadcastKeyType = key
+        broadcastCount += 1
+        // Android GPS is WGS84. Drop every GCJ02 position field: the guidance
+        // parser must fall back to the phone fix, never to a broadcast coordinate.
+        val guidance = values - BROADCAST_COORDINATE_KEYS
+        navigation = when (key) {
+            KEY_NAVIGATION -> AmapAutoBroadcast.navigation(
+                navigation, phone, guidance, wallMs, elapsedMs, budgetMs,
+            )
+            KEY_LANES -> AmapAutoBroadcast.driveWay(
+                navigation, values["EXTRA_DRIVE_WAY"] as? String, wallMs, elapsedMs, budgetMs,
+            )
+            KEY_TRAFFIC_LIGHT -> navigation?.copy(
+                trafficLight = AmapAutoBroadcast.trafficLight(values, wallMs),
+            )
+            else -> navigation
+        }
+    }
+
+    @Synchronized
+    fun broadcastFresh(wallMs: Long): Boolean =
+        budgetMs > 0L && lastBroadcastMs > 0L && lastBroadcastMs <= wallMs &&
+            wallMs - lastBroadcastMs <= budgetMs
+
+    @Synchronized
+    fun broadcastAgeMs(wallMs: Long): Long? =
+        lastBroadcastMs.takeIf { it > 0L && it <= wallMs }?.let { wallMs - it }
+
+    @Synchronized
+    fun snapshot(wallMs: Long, elapsedMs: Long): NavigationState {
+        navigation = AmapAutoBroadcast.refreshLocation(navigation, phone, wallMs, elapsedMs, budgetMs)
+        val state = (navigation ?: NavigationState()).copy(navigationProvider = PROVIDER)
+        return gate.prepare(state, elapsedMs, wallMs).copy(navAssistSourceStatus = gate.reason)
+    }
+
+    internal companion object {
+        const val PROVIDER = "AMAP_AUTO"
+        const val KEY_NAVIGATION = 10001
+        const val KEY_LANES = 13012
+        const val KEY_TRAFFIC_LIGHT = 60073
+        val SUPPORTED_KEYS = setOf(KEY_NAVIGATION, KEY_LANES, KEY_TRAFFIC_LIGHT)
+
+        /**
+         * Every position and accuracy field the Amap Auto broadcast may carry.
+         * Removing them keeps the WGS84 phone fix and the GCJ02 broadcast fix
+         * strictly separate; non-position fields such as CAR_DIRECTION (heading)
+         * and CUR_SPEED stay available.
+         */
+        val BROADCAST_COORDINATE_KEYS = setOf(
+            "CAR_LATITUDE", "CAR_LONGITUDE", "CAR_ACCURACY", "GPS_ACCURACY", "ACCURACY",
+        )
+    }
+}
diff --git a/app/src/test/kotlin/com/garan/tesnav/KeylessAutoEntryTest.kt b/app/src/test/kotlin/com/garan/tesnav/KeylessAutoEntryTest.kt
new file mode 100644
