+package com.garan.tesnav.service
+
+import com.garan.tesnav.export.NavAssistV2ConnectionStatus
+import com.garan.tesnav.model.CameraLanePosition
+import com.garan.tesnav.model.NavigationMode
+import com.garan.tesnav.model.NavigationState
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class KeylessAutoPresenterTest {
+    private fun camera(
+        valid: Boolean = true,
+        laneIndex: Int? = 2,
+        laneCount: Int? = 4,
+        ageAtReceiptMs: Long = 0L,
+        validForMs: Long = 1_200L,
+        receivedAtElapsedMs: Long = 1_000L,
+        routeRevision: Long = 7L,
+    ) = CameraLanePosition(valid, laneIndex, laneCount, ageAtReceiptMs, validForMs, receivedAtElapsedMs, routeRevision)
+
+    private fun inputs(
+        running: Boolean = true,
+        broadcastKeyType: Int? = 10_001,
+        broadcastAgeMs: Long? = 200L,
+        broadcastFresh: Boolean = true,
+        broadcastCount: Long = 42L,
+        locationRejection: KeylessLocationRejection = KeylessLocationRejection.NONE,
+        locationAccuracyM: Float? = 8.5f,
+        locationAgeMs: Long? = 300L,
+        mockRejectedCount: Long = 0L,
+        navigation: NavigationState = NavigationState(
+            navigationMode = NavigationMode.REALTIME,
+            routePlanned = true,
+            routeMatched = true,
+            navAssistSourceStatus = "healthy",
+            routeRevision = 7L,
+        ),
+        c3Status: NavAssistV2ConnectionStatus = NavAssistV2ConnectionStatus.ONLINE,
+        c3Endpoint: String? = "udp://192.168.53.232:4213",
+        c3Error: String? = null,
+        c3Sequence: Long? = 128L,
+        c3Acknowledged: Boolean = true,
+        cameraLane: CameraLanePosition? = null,
+        sessionId: String = "1f3c5b7a-9d2e-4a11-b0c3-8e7f6a5d4c3b",
+        coordinateSystem: String = "wgs84",
+        validForMs: Long = 1_200L,
+        nowElapsedMs: Long = 1_500L,
+    ) = KeylessAutoInputs(
+        running, broadcastKeyType, broadcastAgeMs, broadcastFresh, broadcastCount, locationRejection,
+        locationAccuracyM, locationAgeMs, mockRejectedCount, navigation, c3Status, c3Endpoint, c3Error,
+        c3Sequence, c3Acknowledged, cameraLane, sessionId, coordinateSystem, validForMs, nowElapsedMs,
+    )
+
+    @Test
+    fun `an absolute confirmed lane is shown with its total`() {
+        val display = KeylessAutoPresenter.present(inputs(cameraLane = camera()))
+
+        assertEquals("C3 摄像头位置：第 2／4 车道", display.cameraLane)
+    }
+
+    @Test
+    fun `an expired receipt becomes unknown instead of keeping the last index`() {
+        val display = KeylessAutoPresenter.present(
+            inputs(cameraLane = camera(), nowElapsedMs = 3_000L),
+        )
+
+        assertEquals("C3 摄像头位置：未知（回执已过期）", display.cameraLane)
+    }
+
+    @Test
+    fun `a receipt for another route revision is rejected as unknown`() {
+        val display = KeylessAutoPresenter.present(
+            inputs(
+                cameraLane = camera(routeRevision = 9L),
+                navigation = NavigationState(routeRevision = 7L),
+            ),
+        )
+
+        assertEquals("C3 摄像头位置：未知（路线不一致）", display.cameraLane)
+    }
+
+    @Test
+    fun `a visible-only observation is never promoted to an absolute index`() {
+        val display = KeylessAutoPresenter.present(
+            inputs(cameraLane = camera(valid = false, laneIndex = null, laneCount = null)),
+        )
+
+        assertEquals("C3 摄像头位置：未知（C3 未确认绝对编号）", display.cameraLane)
+    }
+
+    @Test
+    fun `no camera receipt at all shows unknown`() {
+        assertEquals(
+            "C3 摄像头位置：未知（尚未收到）",
+            KeylessAutoPresenter.present(inputs(cameraLane = null)).cameraLane,
+        )
+    }
+
+    @Test
+    fun `an expired broadcast is reported as expired with its age`() {
+        val display = KeylessAutoPresenter.present(
+            inputs(broadcastFresh = false, broadcastAgeMs = 4_500L),
+        )
+
+        assertTrue(display.broadcast.contains("已过期"))
+        assertTrue(display.broadcast.contains("4500 ms 前"))
+        assertTrue(display.broadcast.contains("导航数据（10001）"))
+    }
+
+    @Test
+    fun `a fresh broadcast reports its real type and age`() {
+        assertEquals(
+            "车机广播：车道数据（13012） · 120 ms 前 · 共 42 条",
+            KeylessAutoPresenter.present(inputs(broadcastKeyType = 13_012, broadcastAgeMs = 120L)).broadcast,
+        )
+    }
+
+    @Test
+    fun `location rejection and mock rejections are shown, never a fabricated accuracy`() {
+        val display = KeylessAutoPresenter.present(
+            inputs(
+                locationRejection = KeylessLocationRejection.STALE,
+                locationAccuracyM = null,
+                locationAgeMs = null,
+                mockRejectedCount = 3L,
+            ),
+        )
+
+        assertEquals("Android 定位（WGS84）：定位已过期 · 已拒绝模拟定位 3 次", display.location)
+    }
+
+    @Test
+    fun `a fresh fix shows its real accuracy and age`() {
+        assertEquals(
+            "Android 定位（WGS84）：±8.5 m · 300 ms 前",
+            KeylessAutoPresenter.present(inputs()).location,
+        )
+    }
+
+    @Test
+    fun `the c3 line separates discovery, acknowledgement and errors`() {
+        assertEquals(
+            "C3 回执：已连接 udp://192.168.53.232:4213 · 序号 128 · 已确认",
+            KeylessAutoPresenter.present(inputs()).c3,
+        )
+        assertEquals(
+            "C3 回执：正在发现 C3",
+            KeylessAutoPresenter.present(
+                inputs(c3Status = NavAssistV2ConnectionStatus.SCANNING, c3Endpoint = null, c3Sequence = null, c3Acknowledged = false),
+            ).c3,
+        )
+        assertEquals(
+            "C3 回执：错误 · 未收到 C3XL UDP 确认",
+            KeylessAutoPresenter.present(
+                inputs(
+                    c3Status = NavAssistV2ConnectionStatus.ERROR,
+                    c3Endpoint = null,
+                    c3Sequence = null,
+                    c3Acknowledged = false,
+                    c3Error = "未收到 C3XL UDP 确认",
+                ),
+            ).c3,
+        )
+    }
+
+    @Test
+    fun `the link line proves the exported coordinate system and session`() {
+        val display = KeylessAutoPresenter.present(inputs())
+
+        assertEquals("会话 1f3c5b7a · 坐标 WGS84 · 有效期 1200 ms", display.link)
+    }
+
+    @Test
+    fun `an unconfirmed route is reported as unconfirmed, not as active`() {
+        val display = KeylessAutoPresenter.present(
+            inputs(
+                navigation = NavigationState(
+                    navigationMode = NavigationMode.IDLE,
+                    routePlanned = false,
+                    navAssistSourceStatus = "inactive",
+                ),
+            ),
+        )
+
+        assertEquals("导航：未开始 · 路线未确认 · 导航未激活", display.navigation)
+    }
+
+    @Test
+    fun `a stopped service reports not started`() {
+        assertEquals(
+            "未启动 · 点击下方按钮开始",
+            KeylessAutoPresenter.present(inputs(running = false)).headline,
+        )
+    }
+}
diff --git a/app/src/test/kotlin/com/garan/tesnav/service/KeylessAutoStateTest.kt b/app/src/test/kotlin/com/garan/tesnav/service/KeylessAutoStateTest.kt
new file mode 100644
index 0000000..41fee3d
--- /dev/null
+++ b/app/src/test/kotlin/com/garan/tesnav/service/KeylessAutoStateTest.kt
@@ -0,0 +1,196 @@
+package com.garan.tesnav.service
+
+import com.garan.tesnav.model.NavigationMode
+import com.garan.tesnav.model.NavigationState
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class KeylessAutoStateTest {
+    private fun phoneFix(wallMs: Long, elapsedMs: Long) = NavigationState(
+        latitude = 31.2304,
+        longitude = 121.4737,
+        accuracy = 5f,
+        bearing = 90f,
+        speedKph = 40f,
+        locationTime = wallMs,
+        locationObservedAtMs = wallMs,
+        locationReceivedElapsedMs = elapsedMs,
+        locationSourceStatus = "phone-gps-wgs84",
+    )
+
+    private fun navigationExtras(latitude: Double = 32.0, longitude: Double = 122.0) = mapOf<String, Any?>(
+        "KEY_TYPE" to 10001,
+        "ROUTE_ALL_DIS" to 12_000,
+        "ROUTE_REMAIN_DIS" to 8_000,
+        "SEG_REMAIN_DIS" to 120,
+        "ICON" to 3,
+        "ROAD_TYPE" to 1,
+        "CUR_ROAD_NAME" to "当前路",
+        "NEXT_ROAD_NAME" to "下一路",
+        "CAR_DIRECTION" to 90,
+        "CUR_SPEED" to 42,
+        "CAR_LATITUDE" to latitude,
+        "CAR_LONGITUDE" to longitude,
+        "CAR_ACCURACY" to 4f,
+    )
+
+    private val lanes = """{"drive_way_enabled":true,"drive_way_size":3,"drive_way_info":[
+        {"drive_way_lane_Back_icon":"15","trafficLaneAdvised":false},
+        {"drive_way_lane_Back_icon":"18","trafficLaneAdvised":true},
+        {"drive_way_lane_Back_icon":"32","trafficLaneAdvised":false}]}"""
+
+    private fun state(budgetMs: Long = 3_000L, progressMs: Long = 6_000L) = KeylessAutoState(budgetMs, progressMs)
+
+    @Test
+    fun `broadcast GCJ02 position is dropped in favour of the WGS84 phone fix`() {
+        val keyless = state()
+        keyless.start(1_000L)
+        keyless.phoneLocation(phoneFix(10_000L, 1_200L))
+        keyless.receive(
+            "AUTONAVI_STANDARD_BROADCAST_SEND", navigationExtras(32.0, 122.0), 10_000L, 1_200L,
+        )
+
+        val prepared = keyless.snapshot(10_100L, 1_300L)
+
+        assertEquals(31.2304, prepared.latitude!!, 0.0)
+        assertEquals(121.4737, prepared.longitude!!, 0.0)
+        assertEquals(5f, prepared.accuracy!!, 0f)
+        assertEquals(10_000L, prepared.locationObservedAtMs)
+        assertEquals(1_200L, prepared.locationReceivedElapsedMs)
+        assertEquals("phone-gps-wgs84", prepared.locationSourceStatus)
+         assertTrue(prepared.navAssistControlAllowed)
+        assertEquals("healthy", prepared.navAssistSourceStatus)
+    }
+
+    @Test
+    fun `a broadcast position never becomes a location without a phone fix`() {
+        val keyless = state()
+        keyless.start(1_000L)
+        keyless.receive(
+            "AUTONAVI_STANDARD_BROADCAST_SEND", navigationExtras(32.0, 122.0), 10_000L, 1_200L,
+        )
+
+        val prepared = keyless.snapshot(10_100L, 1_300L)
+
+        assertNull(prepared.latitude)
+        assertNull(prepared.longitude)
+        assertNull(prepared.accuracy)
+        assertNull(prepared.locationObservedAtMs)
+        assertFalse(prepared.navAssistControlAllowed)
+        assertEquals("awaitingLocation", prepared.navAssistSourceStatus)
+    }
+
+    @Test
+    fun `a stale phone fix cannot be renewed by exporter ticks`() {
+        val keyless = state()
+        keyless.start(1_000L)
+        keyless.phoneLocation(phoneFix(10_000L, 1_200L))
+        keyless.receive(
+            "AUTONAVI_STANDARD_BROADCAST_SEND", navigationExtras(), 10_000L, 1_200L,
+        )
+
+        val prepared = keyless.snapshot(13_050L, 4_250L)
+
+        // The measurement time is preserved, so the gate must reject the stale fix.
+        assertEquals(10_000L, prepared.locationObservedAtMs)
+        assertFalse(prepared.navAssistControlAllowed)
+        assertTrue(prepared.navAssistSourceStatus in setOf("sourceStalled", "sourceClockInvalid", "progressUnconfirmed"))
+    }
+
+    @Test
+    fun `only the three documented broadcast keys are accepted`() {
+        val keyless = state()
+        keyless.start(1_000L)
+
+        keyless.receive("AUTONAVI_STANDARD_BROADCAST_SEND", mapOf("KEY_TYPE" to 99_999), 10_000L, 1_200L)
+
+        assertNull(keyless.lastBroadcastKeyType)
+        assertFalse(keyless.hasObservations)
+        assertEquals(0L, keyless.broadcastCount)
+    }
+
+    @Test
+    fun `broadcast freshness expires and is reported with a real age`() {
+        val keyless = state()
+        keyless.start(1_000L)
+        keyless.receive(
+            "AUTONAVI_STANDARD_BROADCAST_SEND", navigationExtras(), 10_000L, 1_200L,
+        )
+
+        assertTrue(keyless.broadcastFresh(12_000L))
+        assertFalse(keyless.broadcastFresh(13_001L))
+        assertEquals(3_001L, keyless.broadcastAgeMs(13_001L)!!)
+    }
+
+    @Test
+    fun `lane broadcasts reuse the keyed route binding of the shared parser`() {
+        val keyless = state()
+        keyless.start(1_000L)
+        keyless.phoneLocation(phoneFix(10_000L, 1_200L))
+
+        // A lane callback before any keyed guidance cannot install route facts.
+        keyless.receive("AUTONAVI_STANDARD_BROADCAST_SEND", mapOf("KEY_TYPE" to 13012, "EXTRA_DRIVE_WAY" to lanes), 10_000L, 1_200L)
+        assertTrue(keyless.snapshot(10_010L, 1_210L).lanes.isEmpty())
+
+        keyless.receive("AUTONAVI_STANDARD_BROADCAST_SEND", navigationExtras(), 10_000L, 1_250L)
+        keyless.receive("AUTONAVI_STANDARD_BROADCAST_SEND", mapOf("KEY_TYPE" to 13012, "EXTRA_DRIVE_WAY" to lanes), 10_300L, 1_500L)
+
+        val prepared = keyless.snapshot(10_310L, 1_510L)
+        assertEquals(3, prepared.lanes.size)
+        assertEquals(prepared.acceptedPathId, prepared.lanesPathId)
+        assertEquals("auto", prepared.laneLastEvent)
+    }
+
+    @Test
+    fun `traffic light broadcast never invents route or location facts`() {
+        val keyless = state()
+        keyless.start(1_000L)
+        keyless.receive("AUTONAVI_STANDARD_BROADCAST_SEND", navigationExtras(), 10_000L, 1_200L)
+        keyless.receive(
+            "AUTONAVI_STANDARD_BROADCAST_SEND",
+            mapOf("KEY_TYPE" to 60073, "trafficLightStatus" to 2, "dir" to 2, "redLightCountDownSeconds" to 37),
+            10_100L,
+            1_300L,
+        )
+
+        val prepared = keyless.snapshot(10_110L, 1_310L)
+
+        assertEquals(2, prepared.trafficLight?.status)
+        assertEquals(10_000L, prepared.guidanceObservedAtMs)
+        assertEquals(NavigationMode.REALTIME, prepared.navigationMode)
+        assertTrue(prepared.routePlanned)
+    }
+
+    @Test
+    fun `restarting clears every prior conclusion`() {
+        val keyless = state()
+        keyless.start(1_000L)
+        keyless.phoneLocation(phoneFix(10_000L, 1_200L))
+        keyless.receive("AUTONAVI_STANDARD_BROADCAST_SEND", navigationExtras(), 10_000L, 1_200L)
+        assertTrue(keyless.hasObservations)
+
+        keyless.start(5_000L)
+
+        assertFalse(keyless.hasObservations)
+        assertNull(keyless.lastBroadcastKeyType)
+        assertEquals(0L, keyless.broadcastCount)
+        assertFalse(keyless.broadcastFresh(5_100L))
+        val prepared = keyless.snapshot(5_100L, 5_100L)
+        assertNull(prepared.latitude)
+        assertFalse(prepared.navAssistControlAllowed)
+    }
+
+    @Test
+    fun `no observation produces no export state`() {
+        val keyless = state()
+        keyless.start(1_000L)
+
+        assertFalse(keyless.hasObservations)
+        val prepared = keyless.snapshot(1_100L, 1_100L)
+        assertNull(prepared.latitude)
+        assertNull(prepared.guidanceObservedAtMs)
+    }
+}
