-        if (!AmapConfiguration.prepare(applicationContext)) {
+        // Decide before any SDK initialization: reading the saved key is not
+        // initialization, and the keyless broadcast entry must never be forced
+        // through AmapConfiguration.prepare with a blank key.
+        val startupRoute = KeylessAutoEntry.route(
+            hasAmapKey = AmapConfiguration.effectiveKey(applicationContext) != null,
+            extendedNavSources = BuildConfig.EXTENDED_NAV_SOURCES,
+        )
+        if (startupRoute == StartupRoute.KEYLESS_AUTO) {
+            startActivity(Intent(this, KeylessAutoActivity::class.java))
+            finish()
+            return
+        }
+        if (startupRoute == StartupRoute.AMAP_KEY || !AmapConfiguration.prepare(applicationContext)) {
             startActivity(Intent(this, AmapKeyActivity::class.java))
             finish()
             return
