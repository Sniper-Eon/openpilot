+++ b/app/src/test/kotlin/com/garan/tesnav/KeylessAutoEntryTest.kt
@@ -0,0 +1,84 @@
+package com.garan.tesnav
+
+import java.io.File
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class KeylessAutoEntryTest {
+    @Test
+    fun `extended build without a key goes to the keyless entry`() {
+        assertEquals(StartupRoute.KEYLESS_AUTO, KeylessAutoEntry.route(hasAmapKey = false, extendedNavSources = true))
+    }
+
+    @Test
+    fun `a configured key keeps the embedded map with its SDK checks`() {
+        assertEquals(StartupRoute.EMBEDDED_MAP, KeylessAutoEntry.route(hasAmapKey = true, extendedNavSources = true))
+        assertEquals(StartupRoute.EMBEDDED_MAP, KeylessAutoEntry.route(hasAmapKey = true, extendedNavSources = false))
+    }
+
+    @Test
+    fun `a plain build without a key still asks for one`() {
+        assertEquals(StartupRoute.AMAP_KEY, KeylessAutoEntry.route(hasAmapKey = false, extendedNavSources = false))
+    }
+
+    @Test
+    fun `the keyless entry has no AMap SDK reference`() {
+        val keylessSources = listOf(
+            "src/main/kotlin/com/garan/tesnav/KeylessAutoActivity.kt",
+            "src/main/kotlin/com/garan/tesnav/KeylessAutoEntry.kt",
+            "src/main/kotlin/com/garan/tesnav/service/KeylessAutoService.kt",
+            "src/main/kotlin/com/garan/tesnav/service/KeylessAutoState.kt",
+            "src/main/kotlin/com/garan/tesnav/service/KeylessAutoDisplay.kt",
+            "src/main/kotlin/com/garan/tesnav/service/KeylessAutoLocation.kt",
+        )
+
+        for (path in keylessSources) {
+            val source = moduleFile(path).readText()
+            assertFalse("$path must not reference the AMap SDK", source.contains("com.amap"))
+            for (forbidden in FORBIDDEN_SDK_MEMBERS) {
+                assertFalse("$path must not use $forbidden", source.contains(forbidden))
+            }
+        }
+    }
+
+    @Test
+    fun `main activity chooses the keyless entry before any sdk initialization`() {
+        val source = moduleFile("src/main/kotlin/com/garan/tesnav/MainActivity.kt").readText()
+
+        val routeAt = source.indexOf("KeylessAutoEntry.route")
+        val prepareAt = source.indexOf("AmapConfiguration.prepare(applicationContext)")
+        assertTrue("MainActivity must route through KeylessAutoEntry", routeAt >= 0)
+        assertTrue("MainActivity must initialize the SDK", prepareAt >= 0)
+        assertTrue("routing must be decided before AmapConfiguration.prepare", routeAt < prepareAt)
+        assertTrue(source.contains("StartupRoute.KEYLESS_AUTO"))
+        assertTrue(source.contains("KeylessAutoActivity::class.java"))
+    }
+
+    @Test
+    fun `the key editing screen offers the keyless entry`() {
+        val source = moduleFile("src/main/kotlin/com/garan/tesnav/AmapKeyActivity.kt").readText()
+
+        assertTrue(source.contains("BuildConfig.EXTENDED_NAV_SOURCES"))
+        assertTrue(source.contains("KeylessAutoActivity::class.java"))
+    }
+
+    private fun moduleFile(relative: String): File {
+        val suffix = relative.removePrefix("app/")
+        var directory: File? = File(System.getProperty("user.dir") ?: ".").absoluteFile
+        while (directory != null) {
+            File(directory, suffix).takeIf(File::isFile)?.let { return it }
+            File(directory, "app/$suffix").takeIf(File::isFile)?.let { return it }
+            directory = directory.parentFile
+        }
+        error("cannot locate $relative from ${System.getProperty("user.dir")}")
+    }
+
+    private companion object {
+        val FORBIDDEN_SDK_MEMBERS = listOf(
+            "MapsInitializer", "AMapNavi", "AMapLocationClient", "MapView", "CoordinateConverter",
+            "ServiceSettings", "NavigationRepository", "AmapConfiguration",
+        )
+    }
+}
diff --git a/app/src/test/kotlin/com/garan/tesnav/export/NavAssistWgs84SessionTest.kt b/app/src/test/kotlin/com/garan/tesnav/export/NavAssistWgs84SessionTest.kt
new file mode 100644
index 0000000..ac76ede
--- /dev/null
+++ b/app/src/test/kotlin/com/garan/tesnav/export/NavAssistWgs84SessionTest.kt
@@ -0,0 +1,191 @@
+package com.garan.tesnav.export
+
+import com.garan.tesnav.model.NavigationManeuver
+import com.garan.tesnav.model.NavigationMode
+import com.garan.tesnav.model.NavigationState
+import com.google.gson.Gson
+import java.util.concurrent.CopyOnWriteArrayList
+import java.util.concurrent.Executors
+import java.util.concurrent.LinkedBlockingQueue
+import java.util.concurrent.TimeUnit
+import java.util.concurrent.atomic.AtomicInteger
+import kotlinx.coroutines.ExecutorCoroutineDispatcher
+import kotlinx.coroutines.asCoroutineDispatcher
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertNotEquals
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/**
+ * The keyless car-machine entry exports a WGS84 session. This pins the wire
+ * coordinate system, the terminal stop semantics and the new-session-on-restart
+ * requirement that the keyless service relies on.
+ */
+class NavAssistWgs84SessionTest {
+    private fun activeState() = NavigationState(
+        navAssistControlAllowed = true,
+        navigationMode = NavigationMode.REALTIME,
+        routePlanned = true,
+        routeMatched = true,
+        latitude = 31.2304,
+        longitude = 121.4737,
+        accuracy = 2f,
+        bearing = 90f,
+        speedKph = 30f,
+        locationObservedAtMs = 1_000L,
+        guidanceObservedAtMs = 1_000L,
+        guidanceStepIndex = 2,
+        routeRevision = 7L,
+        maneuver = NavigationManeuver.TURN_RIGHT,
+    )
+
+    @Test
+    fun `the default session still exports gcj02`() {
+        val snapshot = NavAssistV2Session("default-coordinates").nextSnapshot(activeState(), 4_000L)
+
+        assertEquals("gcj02", snapshot.coordinateSystem)
+        assertEquals(NavAssistV2Protocol.COORDINATE_SYSTEM, snapshot.coordinateSystem)
+    }
+
+    @Test
+    fun `a wgs84 session exports wgs84 and never changes the shared default`() {
+        val keyless = NavAssistV2Session(
+            sessionId = "keyless-coordinates",
+            validForMs = 500L,
+            coordinateSystem = NavAssistV2Protocol.COORDINATE_SYSTEM_WGS84,
+        )
+
+        assertEquals("wgs84", keyless.nextSnapshot(activeState(), 4_000L).coordinateSystem)
+        assertEquals("gcj02", NavAssistV2Session("unrelated").nextSnapshot(activeState(), 4_000L).coordinateSystem)
+    }
+
+    @Test
+    fun `an undocumented coordinate system is rejected`() {
+        for (value in listOf("bd09", "GCJ02", "", "unknown")) {
+            val failure = runCatching {
+                NavAssistV2Session(sessionId = "bad-coordinates", coordinateSystem = value)
+            }.exceptionOrNull()
+            assertTrue("$value must be rejected", failure is IllegalArgumentException)
+        }
+    }
+
+    @Test
+    fun `the exported wire body carries both the wgs84 label and the real phone fix`() {
+        val bodies = LinkedBlockingQueue<String>()
+        val session = NavAssistV2Session(
+            sessionId = "wire-coordinates",
+            validForMs = 500L,
+            coordinateSystem = NavAssistV2Protocol.COORDINATE_SYSTEM_WGS84,
+        )
+        Executors.newSingleThreadExecutor().asCoroutineDispatcher().use { dispatcher ->
+            val exporter = exporter(
+                session,
+                NavAssistV3UdpClient { body, _, _ ->
+                    bodies.put(body.decodeToString())
+                    NavAssistV3UdpAck("192.168.53.232", null)
+                },
+                dispatcher,
+            )
+            try {
+                exporter.start()
+                val snapshot = Gson().fromJson(
+                    bodies.poll(2, TimeUnit.SECONDS) ?: error("missing snapshot"),
+                    NavAssistV2Snapshot::class.java,
+                )
+                assertEquals("wgs84", snapshot.coordinateSystem)
+                assertEquals(31.2304, snapshot.location!!.latitude, 0.0)
+                assertEquals(1_000L, snapshot.location!!.observedAtMs)
+            } finally {
+                exporter.stop()
+            }
+        }
+    }
+
+    @Test
+    fun `a stopped keyless exporter is terminal so a restart needs a new instance and session`() {
+        val sends = AtomicInteger()
+        val sessions = CopyOnWriteArrayList<String>()
+        val udpClient = NavAssistV3UdpClient { _, sessionId, _ ->
+            sends.incrementAndGet()
+            sessions.add(sessionId)
+            NavAssistV3UdpAck("192.168.53.232", null)
+        }
+        val firstSession = NavAssistV2Session(
+            sessionId = "restart-first",
+            validForMs = 500L,
+            coordinateSystem = NavAssistV2Protocol.COORDINATE_SYSTEM_WGS84,
+        )
+        val secondSession = NavAssistV2Session(
+            sessionId = "restart-second",
+            validForMs = 500L,
+            coordinateSystem = NavAssistV2Protocol.COORDINATE_SYSTEM_WGS84,
+        )
+        assertNotEquals(firstSession.sessionId, secondSession.sessionId)
+
+        Executors.newSingleThreadExecutor().asCoroutineDispatcher().use { dispatcher ->
+            val first = exporter(firstSession, udpClient, dispatcher)
+            var afterStop = 0
+            try {
+                first.start()
+                assertTrue("first session never sent", await { sends.get() > 0 })
+                first.stop()
+                afterStop = sends.get()
+                Thread.sleep(RESTART_OBSERVATION_MS)
+                assertEquals("stop must halt publishing", afterStop, sends.get())
+                // A stopped exporter is terminal; restarting the same instance must not resume.
+                first.start()
+                Thread.sleep(RESTART_OBSERVATION_MS)
+                assertEquals("a stopped exporter must not restart", afterStop, sends.get())
+            } finally {
+                first.stop()
+            }
+
+            // Restart is only possible with a new exporter and a new session.
+            val second = exporter(secondSession, udpClient, dispatcher)
+            try {
+                second.start()
+                assertTrue("replacement session never sent", await { sends.get() > afterStop })
+            } finally {
+                second.stop()
+            }
+        }
+
+        assertTrue(sessions.contains(firstSession.sessionId))
+        assertTrue(sessions.contains(secondSession.sessionId))
+    }
+
+    private fun exporter(
+        session: NavAssistV2Session,
+        udpClient: NavAssistV3UdpClient,
+        dispatcher: ExecutorCoroutineDispatcher,
+    ) = HttpNavAssistV2Exporter(
+        config = NavAssistV2ExportConfig(baseUrl = ""),
+        stateProvider = { activeState() },
+        identity = AndroidKeystoreNavAssistIdentity.generatedForTest(),
+        endpointDiscovery = NavAssistV2EndpointDiscovery {
+            NavAssistV2DiscoveryResult.Found("192.168.53.232", "0123456789abcdef0123456789abcdef")
+        },
+        pinnedDeviceProvider = { null },
+        useUnauthenticatedUdp = true,
+        udpClient = udpClient,
+        publisherDispatcher = dispatcher,
+        navigationSession = session,
+        requireOwnerHandshake = true,
+        ownerSettleMs = 0L,
+        monotonicMs = { 0L },
+        feedbackElapsedMs = { 0L },
+    )
+
+    private fun await(timeoutMs: Long = 2_000L, condition: () -> Boolean): Boolean {
+        val deadline = System.nanoTime() + timeoutMs * 1_000_000L
+        while (System.nanoTime() < deadline) {
+            if (condition()) return true
+            Thread.sleep(10L)
+        }
+        return condition()
+    }
+
+    private companion object {
+        const val RESTART_OBSERVATION_MS = 800L
+    }
+}
diff --git a/app/src/test/kotlin/com/garan/tesnav/service/KeylessAutoLocationTest.kt b/app/src/test/kotlin/com/garan/tesnav/service/KeylessAutoLocationTest.kt
new file mode 100644
index 0000000..c38ea9d
--- /dev/null
+++ b/app/src/test/kotlin/com/garan/tesnav/service/KeylessAutoLocationTest.kt
@@ -0,0 +1,111 @@
+package com.garan.tesnav.service
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertNull
+import org.junit.Test
+
+class KeylessAutoLocationTest {
+    private fun sample(
+        latitude: Double = 31.2304,
+        longitude: Double = 121.4737,
+        accuracyM: Float = 6f,
+        hasAccuracy: Boolean = true,
+        measuredAtMs: Long = 10_000L,
+        receivedElapsedMs: Long = 1_000L,
+        fromMockProvider: Boolean = false,
+        bearingDeg: Float? = 90f,
+        speedMps: Float? = 12f,
+    ) = KeylessLocationSample(
+        latitude = latitude,
+        longitude = longitude,
+        accuracyM = accuracyM,
+        hasAccuracy = hasAccuracy,
+        bearingDeg = bearingDeg,
+        speedMps = speedMps,
+        measuredAtMs = measuredAtMs,
+        receivedElapsedMs = receivedElapsedMs,
+        fromMockProvider = fromMockProvider,
+    )
+
+    @Test
+    fun `a fresh real fix is exported with its original measurement time and WGS84 marker`() {
+        val outcome = keylessLocationOutcome(sample(), nowWallMs = 10_200L, nowElapsedMs = 1_200L)
+
+        val state = (outcome as KeylessLocationOutcome.Accepted).state
+        assertEquals(31.2304, state.latitude!!, 0.0)
+        assertEquals(121.4737, state.longitude!!, 0.0)
+        assertEquals(6f, state.accuracy!!, 0f)
+        assertEquals(90f, state.bearing!!, 0f)
+        assertEquals(12f * 3.6f, state.speedKph, 0.001f)
+        // Measurement time, not read time: a later tick cannot renew the fix.
+        assertEquals(10_000L, state.locationObservedAtMs)
+        assertEquals(10_000L, state.locationTime)
+        assertEquals(1_000L, state.locationReceivedElapsedMs)
+        assertEquals("phone-gps-wgs84", state.locationSourceStatus)
+    }
+
+    @Test
+    fun `mock, inaccurate, invalid and null island fixes are rejected`() {
+        val rejected = mapOf(
+            sample(fromMockProvider = true) to KeylessLocationRejection.MOCK,
+            sample(hasAccuracy = false) to KeylessLocationRejection.MISSING_ACCURACY,
+            sample(accuracyM = 0f) to KeylessLocationRejection.INVALID_FIX,
+            sample(accuracyM = Float.NaN) to KeylessLocationRejection.INVALID_FIX,
+            sample(accuracyM = 250f) to KeylessLocationRejection.INVALID_FIX,
+            sample(latitude = 95.0) to KeylessLocationRejection.INVALID_FIX,
+            sample(longitude = -190.0) to KeylessLocationRejection.INVALID_FIX,
+            sample(latitude = 0.0, longitude = 0.0) to KeylessLocationRejection.INVALID_FIX,
+            sample(measuredAtMs = 0L) to KeylessLocationRejection.CLOCK_INVALID,
+        )
+
+        for ((value, reason) in rejected) {
+            val outcome = keylessLocationOutcome(value, nowWallMs = 10_200L, nowElapsedMs = 1_200L)
+            assertEquals(reason, (outcome as KeylessLocationOutcome.Rejected).reason)
+        }
+    }
+
+    @Test
+    fun `stale or future measurement times never become a valid position`() {
+        assertEquals(
+            KeylessLocationRejection.STALE,
+            (keylessLocationOutcome(sample(), nowWallMs = 11_001L, nowElapsedMs = 1_200L)
+                as KeylessLocationOutcome.Rejected).reason,
+        )
+        // A measurement in the future is a clock problem, never freshness.
+        assertEquals(
+            KeylessLocationRejection.STALE,
+            (keylessLocationOutcome(sample(), nowWallMs = 9_999L, nowElapsedMs = 1_200L)
+                as KeylessLocationOutcome.Rejected).reason,
+        )
+    }
+
+    @Test
+    fun `a stale receive elapsed time is rejected even with a recent measurement`() {
+        assertEquals(
+            KeylessLocationRejection.CLOCK_INVALID,
+            (keylessLocationOutcome(sample(), nowWallMs = 10_200L, nowElapsedMs = 2_500L)
+                as KeylessLocationOutcome.Rejected).reason,
+        )
+    }
+
+    @Test
+    fun `optional bearing and speed stay absent instead of being invented`() {
+        val state = keylessLocationState(
+            sample(bearingDeg = null, speedMps = null), nowWallMs = 10_200L, nowElapsedMs = 1_200L,
+        )!!
+
+        assertNull(state.bearing)
+        assertEquals(0f, state.speedKph, 0f)
+    }
+
+    @Test
+    fun `the convenience wrapper only returns accepted fixes`() {
+        assertNull(keylessLocationState(sample(fromMockProvider = true), 10_200L, 1_200L))
+        assertNull(keylessLocationState(sample(measuredAtMs = 0L), 10_200L, 1_200L))
+        assertEquals(
+            31.2304,
+            keylessLocationState(sample(), 10_200L, 1_200L)!!.latitude!!,
+            0.0,
+        )
+    }
+}
