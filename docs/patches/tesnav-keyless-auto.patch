+package com.garan.tesnav
+
+import android.Manifest
+import android.app.Activity
+import android.content.ComponentName
+import android.content.Context
+import android.content.Intent
+import android.content.ServiceConnection
+import android.content.pm.PackageManager
+import android.graphics.Color
+import android.graphics.Typeface
+import android.os.Build
+import android.os.Bundle
+import android.os.IBinder
+import android.view.Gravity
+import android.view.View
+import android.view.ViewGroup
+import android.widget.Button
+import android.widget.LinearLayout
+import android.widget.ScrollView
+import android.widget.TextView
+import android.widget.Toast
+import com.garan.tesnav.service.KeylessAutoService
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.Job
+import kotlinx.coroutines.SupervisorJob
+import kotlinx.coroutines.cancel
+import kotlinx.coroutines.launch
+
+/**
+ * Keyless car-machine broadcast entry.
+ *
+ * It only uses Android widgets, [android.location.LocationManager], the existing
+ * broadcast parser and the existing UDP exporter. No AMap map, navigation or
+ * coordinate SDK is instantiated, so it works without an AMap Key.
+ */
+class KeylessAutoActivity : Activity() {
+    private val scope = CoroutineScope(SupervisorJob() + Dispatchers.Main.immediate)
+    private var service: KeylessAutoService? = null
+    private var bound = false
+    private var displayJob: Job? = null
+
+    private lateinit var headlineText: TextView
+    private lateinit var broadcastText: TextView
+    private lateinit var locationText: TextView
+    private lateinit var c3Text: TextView
+    private lateinit var cameraLaneText: TextView
+    private lateinit var navigationText: TextView
+    private lateinit var linkText: TextView
+    private lateinit var startButton: Button
+    private lateinit var stopButton: Button
+
+    private val connection = object : ServiceConnection {
+        override fun onServiceConnected(name: ComponentName?, binder: IBinder?) {
+            val connected = (binder as? KeylessAutoService.LocalBinder)?.getService() ?: return
+            service = connected
+            observe(connected)
+        }
+
+        override fun onServiceDisconnected(name: ComponentName?) {
+            displayJob?.cancel()
+            displayJob = null
+            service = null
+            bound = false
+            refreshButtons()
+        }
+    }
+
+    override fun onCreate(savedInstanceState: Bundle?) {
+        super.onCreate(savedInstanceState)
+        headlineText = detail(22f, Color.rgb(15, 76, 92)).apply { setTypeface(typeface, Typeface.BOLD) }
+        broadcastText = detail(15f, Color.rgb(30, 41, 59))
+        locationText = detail(15f, Color.rgb(30, 41, 59))
+        c3Text = detail(15f, Color.rgb(30, 41, 59))
+        cameraLaneText = detail(17f, Color.rgb(0, 105, 92)).apply { setTypeface(typeface, Typeface.BOLD) }
+        navigationText = detail(15f, Color.rgb(30, 41, 59))
+        linkText = detail(13f, Color.rgb(84, 110, 122))
+        startButton = actionButton("启动转发") { startForwarding() }
+        stopButton = actionButton("停止转发") { stopForwarding() }
+        setContentView(createRootView())
+        refreshButtons()
+    }
+
+    private fun createRootView(): ScrollView {
+        val body = LinearLayout(this).apply {
+            orientation = LinearLayout.VERTICAL
+            setPadding(dp(24), dp(32), dp(24), dp(32))
+            setBackgroundColor(Color.rgb(246, 248, 252))
+        }
+        fun heading(value: String) = TextView(this).apply {
+            text = value
+            textSize = 28f
+            setTextColor(Color.rgb(15, 23, 42))
+            setTypeface(typeface, Typeface.BOLD)
+            setPadding(0, 0, 0, dp(8))
+        }
+        fun paragraph(value: String) = TextView(this).apply {
+            text = value
+            textSize = 14f
+            setTextColor(Color.rgb(51, 65, 85))
+            setLineSpacing(dp(3).toFloat(), 1.1f)
+            setPadding(0, dp(6), 0, dp(6))
+        }
+        body.addView(heading("车机广播转发（免高德 Key）"))
+        body.addView(paragraph("只使用 Android 定位、高德车机广播和 C3 UDP 回执，不初始化高德地图 / 导航 SDK，因此不需要高德 Key。"))
+        body.addView(headlineText)
+        body.addView(broadcastText)
+        body.addView(locationText)
+        body.addView(c3Text)
+        body.addView(cameraLaneText)
+        body.addView(navigationText)
+        body.addView(linkText)
+        body.addView(LinearLayout(this).apply {
+            orientation = LinearLayout.HORIZONTAL
+            gravity = Gravity.CENTER_VERTICAL
+            addView(startButton, LinearLayout.LayoutParams(0, dp(52), 1f))
+            addView(stopButton, LinearLayout.LayoutParams(0, dp(52), 1f).apply { marginStart = dp(10) })
+        }, LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT).apply {
+            topMargin = dp(12)
+        })
+        body.addView(paragraph(
+            "说明：\n" +
+                "· 摄像头车道编号为只读显示；不确定、遮挡或过期时显示“未知”，不参与转向、变道或任何车辆控制。\n" +
+                "· 请勿同时开启内置地图入口与本入口的转发，同一导航会话只能有一个发送端。\n" +
+                "· 定位使用手机 GPS 原始 WGS84 坐标并保留测量时间，不会用刷新时间戳续期。\n" +
+                "· 停止会关闭定位、广播接收与 C3 发送；再次启动会创建新的会话。",
+        ))
+        body.addView(Button(this).apply {
+            text = "返回设置"
+            setOnClickListener { finish() }
+        })
+        return ScrollView(this).apply { isFillViewport = true; addView(body) }
+    }
+
+    private fun observe(service: KeylessAutoService) {
+        displayJob?.cancel()
+        displayJob = scope.launch {
+            service.display.collect { display ->
+                headlineText.text = display.headline
+                broadcastText.text = display.broadcast
+                locationText.text = display.location
+                c3Text.text = display.c3
+                cameraLaneText.text = display.cameraLane
+                navigationText.text = display.navigation
+                linkText.text = display.link
+                refreshButtons()
+            }
+        }
+    }
+
+    private fun startForwarding() {
+        if (!hasLocationPermission()) {
+            requestPermissions(LOCATION_PERMISSIONS, LOCATION_PERMISSION_REQUEST)
+            return
+        }
+        requestNotificationPermission()
+        startAndBind()
+    }
+
+    private fun startAndBind() {
+        KeylessAutoService.start(this)
+        bindToService()
+        refreshButtons()
+        toast("已启动车机广播转发")
+    }
+
+    private fun stopForwarding() {
+        stopService(Intent(this, KeylessAutoService::class.java))
+        displayJob?.cancel()
+        displayJob = null
+        if (bound) {
+            runCatching { unbindService(connection) }
+            bound = false
+        }
+        service = null
+        headlineText.text = "已停止"
+        refreshButtons()
+    }
+
+    private fun bindToService() {
+        if (bound) return
+        bound = runCatching {
+            bindService(Intent(this, KeylessAutoService::class.java), connection, Context.BIND_AUTO_CREATE)
+        }.getOrDefault(false)
+    }
+
+    private fun refreshButtons() {
+        if (!::startButton.isInitialized) return
+        val running = service != null || KeylessAutoService.instanceAlive
+        startButton.isEnabled = !running
+        stopButton.isEnabled = running
+    }
+
+    private fun hasLocationPermission(): Boolean =
+        checkSelfPermission(Manifest.permission.ACCESS_FINE_LOCATION) == PackageManager.PERMISSION_GRANTED ||
+            checkSelfPermission(Manifest.permission.ACCESS_COARSE_LOCATION) == PackageManager.PERMISSION_GRANTED
+
+    private fun requestNotificationPermission() {
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.TIRAMISU &&
+            checkSelfPermission(Manifest.permission.POST_NOTIFICATIONS) != PackageManager.PERMISSION_GRANTED
+        ) {
+            requestPermissions(arrayOf(Manifest.permission.POST_NOTIFICATIONS), NOTIFICATION_PERMISSION_REQUEST)
+        }
+    }
+
+    override fun onRequestPermissionsResult(
+        requestCode: Int,
+        permissions: Array<out String>,
+        grantResults: IntArray,
+    ) {
+        super.onRequestPermissionsResult(requestCode, permissions, grantResults)
+        when (requestCode) {
+            LOCATION_PERMISSION_REQUEST -> if (hasLocationPermission()) {
+                startForwarding()
+            } else {
+                toast("缺少定位权限，无法转发车机导航")
+            }
+            NOTIFICATION_PERMISSION_REQUEST -> Unit
+        }
+    }
+
+    override fun onStart() {
+        super.onStart()
+        if (KeylessAutoService.instanceAlive) bindToService()
+        refreshButtons()
+    }
+
+    override fun onStop() {
+        if (bound) {
+            runCatching { unbindService(connection) }
+            bound = false
+        }
+        super.onStop()
+    }
+
+    override fun onDestroy() {
+        displayJob?.cancel()
+        scope.cancel()
+        super.onDestroy()
+    }
+
+    private fun detail(size: Float, color: Int): TextView = TextView(this).apply {
+        textSize = size
+        setTextColor(color)
+        setPadding(0, dp(6), 0, dp(6))
+        setLineSpacing(dp(2).toFloat(), 1.1f)
+    }
+
+    private fun actionButton(label: String, action: () -> Unit): Button = Button(this).apply {
+        text = label
+        textSize = 17f
+        setTextColor(Color.WHITE)
+        backgroundTintList = android.content.res.ColorStateList.valueOf(Color.rgb(0, 120, 255))
+        setOnClickListener { action() }
+    }
+
+    private fun dp(value: Int): Int = (value * resources.displayMetrics.density).toInt()
+    private fun toast(message: String) = Toast.makeText(this, message, Toast.LENGTH_SHORT).show()
+
+    private companion object {
+        const val LOCATION_PERMISSION_REQUEST = 11
+        const val NOTIFICATION_PERMISSION_REQUEST = 12
+        val LOCATION_PERMISSIONS = arrayOf(
+            Manifest.permission.ACCESS_FINE_LOCATION,
+            Manifest.permission.ACCESS_COARSE_LOCATION,
+        )
+    }
+}
