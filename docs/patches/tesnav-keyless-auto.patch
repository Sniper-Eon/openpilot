+package com.garan.tesnav
+
+/** Where startup sends the user before any AMap SDK is initialized. */
+internal enum class StartupRoute { EMBEDDED_MAP, KEYLESS_AUTO, AMAP_KEY }
+
+/**
+ * Startup routing for a build with extended navigation sources.
+ *
+ * A missing AMap Key must not be resolved by initializing the SDK with a blank
+ * key, and the keyless car-machine broadcast entry needs no key at all. Plain
+ * builds without extended sources keep the original key-required behaviour.
+ */
+internal object KeylessAutoEntry {
+    fun route(hasAmapKey: Boolean, extendedNavSources: Boolean): StartupRoute = when {
+        hasAmapKey -> StartupRoute.EMBEDDED_MAP
+        extendedNavSources -> StartupRoute.KEYLESS_AUTO
+        else -> StartupRoute.AMAP_KEY
+    }
+}
