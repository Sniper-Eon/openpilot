@@ -0,0 +1,111 @@
+package com.garan.tesnav.service
+
+import com.garan.tesnav.model.NavigationState
+
+/**
+ * Freshness bound for an exported phone position.
+ *
+ * C3 marks a snapshot as `phoneLocalization` when
+ * `sourceWallTimeMs - locationObservedAtMs` exceeds 1000 ms, so a locally stale
+ * fix is never exported as if it were current.
+ */
+internal const val KEYLESS_LOCATION_MAX_AGE_MS = 1_000L
+
+/** Largest accuracy the wire protocol will carry at all. */
+internal const val KEYLESS_LOCATION_MAX_ACCURACY_M = 200f
+
+/** One Android location callback, free of Android types so it can be tested. */
+internal data class KeylessLocationSample(
+    val latitude: Double,
+    val longitude: Double,
+    val accuracyM: Float,
+    val hasAccuracy: Boolean,
+    val bearingDeg: Float?,
+    val speedMps: Float?,
+    /** The receiver's measurement time, never the time this sample was read. */
+    val measuredAtMs: Long,
+    val receivedElapsedMs: Long,
+    val fromMockProvider: Boolean,
+)
+
+/** Why a location callback was or was not exported; shown to the user, never faked. */
+internal enum class KeylessLocationRejection(val label: String) {
+    NONE("定位有效"),
+    MOCK("拒绝模拟定位"),
+    MISSING_ACCURACY("定位无精度"),
+    INVALID_FIX("坐标无效"),
+    STALE("定位已过期"),
+    CLOCK_INVALID("定位时间无效"),
+    PROVIDER_DISABLED("定位服务不可用"),
+    PERMISSION_MISSING("缺少定位权限"),
+}
+
+internal sealed interface KeylessLocationOutcome {
+    data class Accepted(val state: NavigationState) : KeylessLocationOutcome
+    data class Rejected(val reason: KeylessLocationRejection) : KeylessLocationOutcome
+}
+
+/**
+ * Converts one Android location callback into an exportable WGS84 observation.
+ *
+ * Rejects mock providers, missing accuracy, out-of-range or null-island
+ * coordinates, a missing or future measurement time, and a measurement older
+ * than [budgetMs]. The receiver's measurement time is preserved verbatim into
+ * [NavigationState.locationObservedAtMs]; it is never re-stamped at read time,
+ * so a repeated exporter tick cannot renew a stale fix.
+ */
+internal fun keylessLocationOutcome(
+    sample: KeylessLocationSample,
+    nowWallMs: Long,
+    nowElapsedMs: Long,
+    budgetMs: Long = KEYLESS_LOCATION_MAX_AGE_MS,
+): KeylessLocationOutcome {
+    if (sample.fromMockProvider) return KeylessLocationOutcome.Rejected(KeylessLocationRejection.MOCK)
+    if (!sample.hasAccuracy) return KeylessLocationOutcome.Rejected(KeylessLocationRejection.MISSING_ACCURACY)
+    val accuracy = sample.accuracyM
+    if (!accuracy.isFinite() || accuracy <= 0f || accuracy > KEYLESS_LOCATION_MAX_ACCURACY_M) {
+        return KeylessLocationOutcome.Rejected(KeylessLocationRejection.INVALID_FIX)
+    }
+    if (!sample.latitude.isFinite() || sample.latitude !in -90.0..90.0 ||
+        !sample.longitude.isFinite() || sample.longitude !in -180.0..180.0 ||
+        (sample.latitude == 0.0 && sample.longitude == 0.0)
+    ) {
+        return KeylessLocationOutcome.Rejected(KeylessLocationRejection.INVALID_FIX)
+    }
+    if (budgetMs <= 0L || sample.measuredAtMs <= 0L) {
+        return KeylessLocationOutcome.Rejected(KeylessLocationRejection.CLOCK_INVALID)
+    }
+    if (nowWallMs < sample.measuredAtMs || nowWallMs - sample.measuredAtMs > budgetMs) {
+        return KeylessLocationOutcome.Rejected(KeylessLocationRejection.STALE)
+    }
+    if (sample.receivedElapsedMs < 0L || sample.receivedElapsedMs > nowElapsedMs ||
+        nowElapsedMs - sample.receivedElapsedMs > budgetMs
+    ) {
+        return KeylessLocationOutcome.Rejected(KeylessLocationRejection.CLOCK_INVALID)
+    }
+    val bearing = sample.bearingDeg?.takeIf { it.isFinite() && it in 0f..360f }
+    val speedKph = sample.speedMps?.takeIf { it.isFinite() && it >= 0f }?.times(3.6f) ?: 0f
+    return KeylessLocationOutcome.Accepted(
+        NavigationState(
+            latitude = sample.latitude,
+            longitude = sample.longitude,
+            accuracy = accuracy,
+            bearing = bearing,
+            speedKph = speedKph,
+            locationTime = sample.measuredAtMs,
+            locationObservedAtMs = sample.measuredAtMs,
+            locationReceivedElapsedMs = sample.receivedElapsedMs,
+            // Marks the coordinate system at the only place it can be trusted.
+            locationSourceStatus = "phone-gps-wgs84",
+        ),
+    )
+}
+
+/** Convenience wrapper for callers that only need the accepted observation. */
+internal fun keylessLocationState(
+    sample: KeylessLocationSample,
+    nowWallMs: Long,
+    nowElapsedMs: Long,
+    budgetMs: Long = KEYLESS_LOCATION_MAX_AGE_MS,
+): NavigationState? = (keylessLocationOutcome(sample, nowWallMs, nowElapsedMs, budgetMs)
+    as? KeylessLocationOutcome.Accepted)?.state
diff --git a/app/src/main/kotlin/com/garan/tesnav/service/KeylessAutoService.kt b/app/src/main/kotlin/com/garan/tesnav/service/KeylessAutoService.kt
