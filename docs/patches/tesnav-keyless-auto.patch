+package com.garan.tesnav.service
+
+import com.garan.tesnav.export.NavAssistV2ConnectionStatus
+import com.garan.tesnav.model.CameraLanePosition
+import com.garan.tesnav.model.NavigationMode
+import com.garan.tesnav.model.NavigationState
+import java.util.Locale
+
+/** Everything the keyless screen shows, gathered without touching the UI toolkit. */
+internal data class KeylessAutoInputs(
+    val running: Boolean,
+    val broadcastKeyType: Int?,
+    val broadcastAgeMs: Long?,
+    val broadcastFresh: Boolean,
+    val broadcastCount: Long,
+    val locationRejection: KeylessLocationRejection,
+    val locationAccuracyM: Float?,
+    val locationAgeMs: Long?,
+    val mockRejectedCount: Long,
+    val navigation: NavigationState,
+    val c3Status: NavAssistV2ConnectionStatus,
+    val c3Endpoint: String?,
+    val c3Error: String?,
+    val c3Sequence: Long?,
+    val c3Acknowledged: Boolean,
+    val cameraLane: CameraLanePosition?,
+    val sessionId: String,
+    val coordinateSystem: String,
+    val validForMs: Long,
+    val nowElapsedMs: Long,
+)
+
+internal data class KeylessAutoDisplay(
+    val headline: String,
+    val broadcast: String,
+    val location: String,
+    val c3: String,
+    val cameraLane: String,
+    val navigation: String,
+    val link: String,
+) {
+    fun lines(): List<String> = listOf(headline, broadcast, location, c3, cameraLane, navigation, link)
+}
+
+/**
+ * Renders the keyless entry's verification screen.
+ *
+ * Every unknown or expired observation is rendered as 未知 with its reason; a
+ * locally visible "1/1" never becomes an absolute lane index because C3 only
+ * sets `valid` for an absolute confirmation, and an expired receipt is cleared
+ * here before display.
+ */
+internal object KeylessAutoPresenter {
+    fun present(input: KeylessAutoInputs): KeylessAutoDisplay = KeylessAutoDisplay(
+        headline = headline(input),
+        broadcast = broadcast(input),
+        location = location(input),
+        c3 = c3(input),
+        cameraLane = cameraLane(input),
+        navigation = navigation(input),
+        link = link(input),
+    )
+
+    private fun headline(input: KeylessAutoInputs): String = when {
+        !input.running -> "未启动 · 点击下方按钮开始"
+        input.c3Acknowledged -> "运行中 · C3 已回执"
+        else -> "运行中 · 等待 C3 回执"
+    }
+
+    private fun broadcast(input: KeylessAutoInputs): String {
+        val key = input.broadcastKeyType
+        val age = input.broadcastAgeMs
+        if (key == null || age == null) return "车机广播：未收到"
+        val type = when (key) {
+            KeylessAutoState.KEY_NAVIGATION -> "导航数据（10001）"
+            KeylessAutoState.KEY_LANES -> "车道数据（13012）"
+            KeylessAutoState.KEY_TRAFFIC_LIGHT -> "红绿灯（60073）"
+            else -> "未知类型（$key）"
+        }
+        return if (!input.broadcastFresh) {
+            "车机广播：已过期（最近 $type，$age ms 前，共 ${input.broadcastCount} 条）"
+        } else {
+            "车机广播：$type · $age ms 前 · 共 ${input.broadcastCount} 条"
+        }
+    }
+
+    private fun location(input: KeylessAutoInputs): String {
+        val mock = if (input.mockRejectedCount > 0L) " · 已拒绝模拟定位 ${input.mockRejectedCount} 次" else ""
+        if (input.locationRejection != KeylessLocationRejection.NONE) {
+            return "Android 定位（WGS84）：${input.locationRejection.label}$mock"
+        }
+        val accuracy = input.locationAccuracyM?.let { String.format(Locale.US, "±%.1f m", it) } ?: "精度未知"
+        val age = input.locationAgeMs?.let { " · $it ms 前" } ?: ""
+        return "Android 定位（WGS84）：$accuracy$age$mock"
+    }
+
+    private fun c3(input: KeylessAutoInputs): String {
+        val status = when (input.c3Status) {
+            NavAssistV2ConnectionStatus.UNCONFIGURED -> "未配置"
+            NavAssistV2ConnectionStatus.SCANNING -> "正在发现 C3"
+            NavAssistV2ConnectionStatus.MULTIPLE_DEVICES -> "发现多个已认证 C3"
+            NavAssistV2ConnectionStatus.DISCOVERED -> "已发现 C3"
+            NavAssistV2ConnectionStatus.ONLINE -> "已连接"
+            NavAssistV2ConnectionStatus.ERROR -> "错误"
+        }
+        val endpoint = input.c3Endpoint?.let { " $it" }.orEmpty()
+        val sequence = input.c3Sequence?.let { " · 序号 $it" }.orEmpty()
+        val ack = if (input.c3Acknowledged) " · 已确认" else ""
+        val error = input.c3Error?.let { " · $it" }.orEmpty()
+        return "C3 回执：$status$endpoint$sequence$ack$error"
+    }
+
+    private fun cameraLane(input: KeylessAutoInputs): String {
+        val camera = input.cameraLane ?: return "C3 摄像头位置：未知（尚未收到）"
+        if (camera.routeRevision != input.navigation.routeRevision) {
+            return "C3 摄像头位置：未知（路线不一致）"
+        }
+        val live = camera.forDisplay(input.nowElapsedMs)
+        return when {
+            live.valid && live.laneIndex != null -> "C3 摄像头位置：${live.label()}"
+            camera.valid -> "C3 摄像头位置：未知（回执已过期）"
+            else -> "C3 摄像头位置：未知（C3 未确认绝对编号）"
+        }
+    }
+
+    private fun navigation(input: KeylessAutoInputs): String {
+        val state = input.navigation
+        val mode = when (state.navigationMode) {
+            NavigationMode.IDLE -> "未开始"
+            NavigationMode.ROUTE_PLANNED -> "已规划路线"
+            NavigationMode.REALTIME -> "实时导航"
+            NavigationMode.SIMULATION -> "模拟导航"
+            NavigationMode.ARRIVED -> "已到达"
+        }
+        val route = if (state.routePlanned && state.routeMatched == true) "路线已确认" else "路线未确认"
+        val source = when (state.navAssistSourceStatus) {
+            "healthy" -> "数据有效"
+            "inactive" -> "导航未激活"
+            "requiresExplicitStart" -> "等待显式启动"
+            "awaitingLocation" -> "等待定位"
+            "awaitingGuidance" -> "等待车机导航数据"
+            "sourceStalled" -> "车机数据已中断"
+            "sourceClockInvalid" -> "定位时间无效"
+            "guidanceClockInvalid" -> "导航数据时间无效"
+            "progressUnconfirmed" -> "进度未确认"
+            "sourceInvalid" -> "定位信号弱"
+            "routeUnconfirmed" -> "路线未确认"
+            "guidanceUnconfirmed" -> "导航数据未确认"
+            "awaitingSourceRecovery" -> "等待数据恢复"
+            "budgetsUnconfirmed" -> "预算未确认"
+            else -> state.navAssistSourceStatus
+        }
+        return "导航：$mode · $route · $source"
+    }
+
+    private fun link(input: KeylessAutoInputs): String =
+        "会话 ${input.sessionId.take(8)} · 坐标 ${input.coordinateSystem.uppercase(Locale.US)} · 有效期 ${input.validForMs} ms"
+}
